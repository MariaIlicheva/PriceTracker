server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # Запросы к API пересылаем бэкенду. Адрес подставляется при старте контейнера из переменной BACKEND_URL
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Всё остальное — файлы фронтенда; неизвестный адрес отдаёт index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
